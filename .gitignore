# ==============================================
#   1. SISTEMA OPERATIVO & LOGS (GLOBAL)
# ==============================================
.DS_Store
Thumbs.db
*.log
npm-debug.log
yarn-error.log
testem.log
/libpeerconnection.log

# ==============================================
#   2. SECRETOS & SEGURIDAD (¡CRÍTICO!)
# ==============================================
# Variables de entorno
.env
.env.*

# Configuración de IA y Tokens (Locofy/Gemini)
.gemini/settings.json
backend/.gemini/settings.json
frontend/.gemini/settings.json
**/*.json.user

# ==============================================
#   3. IDEs & EDITORES
# ==============================================
# General
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/*

# Visual Studio Code
.vscode/*
# ! significa "No ignorar" (Es decir, subir al repo)
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# mcp.json suele tener tokens, mejor ignorarlo por seguridad
.vscode/mcp.json

# ==============================================
#   4. BACKEND (PYTHON / DJANGO)
# ==============================================
# Bytecode compilado
**/__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
.venv/
env/
**/venv/
**/.venv/
**/env/

# Base de datos local
*.sqlite3
db.sqlite3
backend/db.sqlite3

# Archivos media de prueba (opcional)
backend/media/

# ==============================================
#   5. FRONTEND (ANGULAR / NODE)
# ==============================================
# Dependencias
node_modules/
/node_modules

# Build y Compilación
dist/
/dist
/tmp
/out-tsc
/bazel-out
/connect.lock
/coverage
/typings
__screenshots__/

# Angular Cache
/.angular/cache
.sass-cache/

# Nota: package-lock.json SÍ se suele subir para consistencia de versiones.
# Si prefieres no subirlo, descomenta la siguiente línea:
# package-lock.json

# ==============================================
#   6. LOCOFY & HERRAMIENTAS DE IA
# ==============================================
.locofy
locofy.config.json