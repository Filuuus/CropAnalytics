# Copia este archivo a backend/.env y llena los valores.

# Django
# DJANGO_DEBUG=0 en producción; ahí DJANGO_SECRET_KEY es obligatorio
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Super administrador inicial (lo crea la migración 0002_auth_roles)
SADMIN_EMAIL=sadmin@cropanalytics.local
SADMIN_PASSWORD=

# PostgreSQL (lo usan Django y docker-compose)
POSTGRES_DB=crop_analytics
POSTGRES_USER=usuario_maiz
POSTGRES_PASSWORD=
# Opcional, reemplaza las variables POSTGRES_* para Django:
# DATABASE_URL=postgres://usuario:password@localhost:5432/crop_analytics

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
